# =============================================================
# Analista SemParar - Backend (variáveis de ambiente)
# Copie este arquivo para .env e ajuste os valores.
# NÃO commite o .env real (ele está no .gitignore).
# =============================================================

# Caminho do banco SQLite de transações (fixo dentro do container)
DB_PATH=/var/abastece/dados/abastece.db

# Lista de equipamentos monitorados (JSON).
# Formato: [{"id": "...", "ip": "...", "nome": "..."}, ...]
EQUIPAMENTOS=[{"id":"antena_01","ip":"192.0.2.10","nome":"Antena Lado A"},{"id":"antena_02","ip":"192.0.2.11","nome":"Antena Lado B"},{"id":"sensor_vpar","ip":"192.0.2.20","nome":"Câmera VPAR"},{"id":"gateway","ip":"8.8.8.8","nome":"Saída Internet"}]

# Código do conveniado usado na validação de arquivos
CONVENIADO_CODE=SUA_CHAVE_AQUI

# Nome do servidor SFTP conforme config do iFM
SFTP_SERVER=DS_ABAST.SEU_CODIGO_1

# IP da NUC usado na validação (IPs NUC)
NUC_IP=192.0.2.21
